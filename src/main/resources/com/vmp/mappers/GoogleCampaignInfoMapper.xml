		<if test="query.startDateTime != null and query.startDateTime!=''">
			 <![CDATA[ and  start_date_time=str_to_date(#{query.startDateTime}, '%Y-%m-%d') ]]>
		</if>
		<if test="query.endDateTime != null and query.endDateTime!=''">
			 <![CDATA[ and  end_date_time=str_to_date(#{query.endDateTime}, '%Y-%m-%d') ]]>
		</if>
		<if test="query.personInCharge != null and query.personInCharge!=''">
