		</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
		<where>
			<include refid="base_condition_filed" />
			<if test="query.campaignIdFuzzy!= null  and query.campaignIdFuzzy!=''">
				 and  campaign_id like concat('%', #{query.campaignIdFuzzy}, '%')
			</if>
			<if test="query.campaignNameFuzzy!= null  and query.campaignNameFuzzy!=''">
				 and  campaign_name like concat('%', #{query.campaignNameFuzzy}, '%')
			</if>
			<if test="query.currencyCodeFuzzy!= null  and query.currencyCodeFuzzy!=''">
				 and  currency_code like concat('%', #{query.currencyCodeFuzzy}, '%')
			</if>
			<if test="query.statusFuzzy!= null  and query.statusFuzzy!=''">
				 and  status like concat('%', #{query.statusFuzzy}, '%')
			</if>
			<if test="query.advertisingChannelTypeFuzzy!= null  and query.advertisingChannelTypeFuzzy!=''">
				 and  advertising_channel_type like concat('%', #{query.advertisingChannelTypeFuzzy}, '%')
			</if>
			<if test="query.startDateTimeStart!= null and query.startDateTimeStart!=''">
				 <![CDATA[ and  start_date_time>=str_to_date(#{query.startDateTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.startDateTimeEnd!= null and query.startDateTimeEnd!=''">
				 <![CDATA[ and  start_date_time< date_sub(str_to_date(#{query.startDateTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
			<if test="query.endDateTimeStart!= null and query.endDateTimeStart!=''">
				 <![CDATA[ and  end_date_time>=str_to_date(#{query.endDateTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.endDateTimeEnd!= null and query.endDateTimeEnd!=''">
				 <![CDATA[ and  end_date_time< date_sub(str_to_date(#{query.endDateTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
			<if test="query.personInChargeFuzzy!= null  and query.personInChargeFuzzy!=''">
				 and  person_in_charge like concat('%', #{query.personInChargeFuzzy}, '%')
			</if>
			<if test="query.campaignIdList != null">
				<choose>
					<when test="query.campaignIdList.size() > 0">
						and campaign_id in
						<foreach collection="query.campaignIdList" item="campaignId" open="(" separator="," close=")">
							#{campaignId}
						</foreach>
					</when>
					<otherwise>
						and 1 = 0
					</otherwise>
				</choose>
			</if>
		</where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
